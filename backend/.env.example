# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── Security ──────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY

# Generate: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_KEY

# ── LLM Provider (choose one) ─────────────────────────────────────────────────
# Option A: Azure AI Foundry (recommended)
AZURE_FOUNDRY_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_GPT4O_DEPLOYMENT=gpt-4o
AZURE_FOUNDRY_GPT4O_MINI_DEPLOYMENT=gpt-4o-mini
AZURE_FOUNDRY_WHISPER_DEPLOYMENT=whisper

# Option B: OpenAI or any OpenAI-compatible API (Ollama, etc.)
# LLM_PROVIDER=openai
# LLM_API_STYLE=openai
# LLM_ENDPOINT=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL_MAIN=gpt-4o
# LLM_MODEL_MINI=gpt-4o-mini

# ── Azure Speech (for TTS in bot) ─────────────────────────────────────────────
AZURE_SPEECH_KEY=
AZURE_SPEECH_ENDPOINT=https://eastus.api.cognitive.microsoft.com/
AZURE_TTS_VOICE=en-US-AriaNeural

# ── Azure Blob Storage (optional — for audio/video archival) ─────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=recordings

# ── Bot Settings ──────────────────────────────────────────────────────────────
BOT_DISPLAY_NAME=Zapper Recorder
BOT_LOBBY_TIMEOUT_SECONDS=300
MAX_CONCURRENT_BOTS=4

# Google account for the bot to join Google Meet
BOT_GOOGLE_EMAIL=
BOT_GOOGLE_PASSWORD=

# ── Live Transcription ────────────────────────────────────────────────────────
# whisper = Whisper audio pipeline (default)
# captions = platform native captions (Teams)
LIVE_ENGINE=whisper
LIVE_LANGUAGE=
LIVE_WHISPER_BACKEND=foundry
LIVE_LLM_CORRECT=false

# ── Post-Meeting Transcription ────────────────────────────────────────────────
WHISPER_MODEL=small
WHISPER_LANGUAGE=
TRANSCRIPT_LLM_CORRECT=true
TRANSCRIPT_LLM_BATCH=25
TRANSCRIPT_LLM_MAX_TOKENS=4000

# ── Voice Fingerprinting ──────────────────────────────────────────────────────
# Cosine similarity threshold for ECAPA-TDNN speaker matching
VOICE_MATCH_THRESHOLD=0.70

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Set this in the frontend's .env file (src/.env or project root .env)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
